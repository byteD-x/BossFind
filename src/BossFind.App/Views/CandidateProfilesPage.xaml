<Page
    x:Class="BossFind.App.Views.CandidateProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <Grid Padding="28" RowDefinitions="Auto,*" ColumnDefinitions="300,*,340">
        <Grid Grid.ColumnSpan="3" Margin="0,0,0,24" ColumnDefinitions="*,Auto,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="候选人档案" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="维护候选人的基本信息、事实和来源。" Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>
            <ProgressRing Grid.Column="1" Width="24" Height="24" IsActive="{Binding IsBusy}" Margin="0,0,20,0" />
            <Button Grid.Column="2" Content="新建档案" Click="OnNewProfileClick" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*">
            <TextBlock Text="档案列表" FontWeight="SemiBold" Margin="0,0,0,10" />
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10">
                <TextBox
                    x:Name="SearchTextBox"
                    PlaceholderText="搜索姓名、职位或所在地"
                    Text="{Binding SearchText, Mode=TwoWay}"
                    KeyDown="OnSearchKeyDown" />
                <Button Grid.Column="1" Content="搜索" Click="OnSearchClick" />
                <Button Grid.Column="2" Content="清除" Click="OnClearSearchClick" />
            </Grid>
            <TextBlock Grid.Row="2" Text="{Binding SearchResultMessage}" Opacity="0.68" Margin="0,0,0,8" />
            <ListView
                x:Name="ProfilesList"
                Grid.Row="3"
                Margin="0,28,0,0"
                ItemsSource="{Binding Profiles}"
                SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                SelectionChanged="OnProfileSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="4,8" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Headline}" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Location}" Opacity="0.58" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="28,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <TextBlock Text="档案详情" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox Header="姓名" Text="{Binding Name, Mode=TwoWay}" />
                <TextBox Header="当前职位 / 标题" Text="{Binding Headline, Mode=TwoWay}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <TextBox Header="所在地" Text="{Binding Location, Mode=TwoWay}" />
                    <TextBox Grid.Column="1" Header="电话" Text="{Binding Phone, Mode=TwoWay}" />
                </Grid>
                <TextBox Header="邮箱" Text="{Binding Email, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="保存档案" Click="OnSaveProfileClick" />
                    <Button Content="删除档案" Click="OnDeleteProfileClick" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.72" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="2" BorderThickness="1,0,0,0" Padding="28,0,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
                <TextBlock Text="事实记录" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox
                    Grid.Row="1"
                    Header="类别"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedFactCategory, Mode=TwoWay}" />
                <TextBox Grid.Row="2" Header="事实内容" Text="{Binding FactContent, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBox Header="来源" Text="{Binding FactSourceText, Mode=TwoWay}" />
                    <NumberBox
                        Grid.Column="1"
                        Header="置信度"
                        Width="110"
                        Minimum="0"
                        Maximum="1"
                        SmallChange="0.1"
                        Value="{Binding FactConfidence, Mode=TwoWay}" />
                </Grid>
                <StackPanel Grid.Row="4" Spacing="12">
                    <CheckBox Content="已确认" IsChecked="{Binding FactIsConfirmed, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="{Binding FactActionLabel}" Click="OnSaveFactClick" />
                        <Button Content="取消编辑" Click="OnCancelFactClick" IsEnabled="{Binding IsEditingFact}" />
                    </StackPanel>
                    <ListView ItemsSource="{Binding Facts}" MaxHeight="360">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Category}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SourceText}" Opacity="0.62" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                        <Button Content="编辑" Tag="{Binding}" Click="OnEditFactClick" />
                                        <Button Content="删除" Tag="{Binding}" Click="OnDeleteFactClick" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
