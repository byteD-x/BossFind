<Application
    x:Class="BossFind.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BossFind.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#1677FF" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#0958D9" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0958D9" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0958D9" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#0958D9" />
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="AppWorkspaceBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSurfaceInsetBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="AppDividerBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="AppBodyTextBrush" Color="#334155" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#64748B" />
                    <SolidColorBrush x:Key="AppPlaceholderTextBrush" Color="#94A3B8" />
                    <SolidColorBrush x:Key="AppGoodBrush" Color="#10B981" />
                    <SolidColorBrush x:Key="AppWarningBrush" Color="#F59E0B" />
                    <SolidColorBrush x:Key="AppErrorBrush" Color="#DC2626" />
                    <SolidColorBrush x:Key="AppInfoBrush" Color="#1677FF" />
                    <SolidColorBrush x:Key="AppFocusSecondaryBrush" Color="#93C5FD" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#1677FF" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#0958D9" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0958D9" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0958D9" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#0958D9" />
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="AppWorkspaceBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSurfaceInsetBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="AppDividerBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="AppBodyTextBrush" Color="#334155" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#64748B" />
                    <SolidColorBrush x:Key="AppPlaceholderTextBrush" Color="#94A3B8" />
                    <SolidColorBrush x:Key="AppGoodBrush" Color="#10B981" />
                    <SolidColorBrush x:Key="AppWarningBrush" Color="#F59E0B" />
                    <SolidColorBrush x:Key="AppErrorBrush" Color="#DC2626" />
                    <SolidColorBrush x:Key="AppInfoBrush" Color="#1677FF" />
                    <SolidColorBrush x:Key="AppFocusSecondaryBrush" Color="#93C5FD" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#5B9BFF" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#8AB8FF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#8AB8FF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#8AB8FF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#8AB8FF" />
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="AppWorkspaceBrush" Color="#111C31" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#172033" />
                    <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="#1E2A40" />
                    <SolidColorBrush x:Key="AppSurfaceInsetBrush" Color="#111C31" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#334155" />
                    <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#475569" />
                    <SolidColorBrush x:Key="AppDividerBrush" Color="#26354D" />
                    <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="AppBodyTextBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="AppPlaceholderTextBrush" Color="#94A3B8" />
                    <SolidColorBrush x:Key="AppGoodBrush" Color="#34D399" />
                    <SolidColorBrush x:Key="AppWarningBrush" Color="#FBBF24" />
                    <SolidColorBrush x:Key="AppErrorBrush" Color="#F87171" />
                    <SolidColorBrush x:Key="AppInfoBrush" Color="#5B9BFF" />
                    <SolidColorBrush x:Key="AppFocusSecondaryBrush" Color="#1D4ED8" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 全局设计令牌，页面通过 ThemeResource 统一引用。 -->
            <x:Double x:Key="AppCardRadius">12</x:Double>
            <x:Double x:Key="AppControlRadius">6</x:Double>
            <x:Double x:Key="AppMotionFastMilliseconds">200</x:Double>
            <x:Double x:Key="AppCardShadowOpacity">0.05</x:Double>
            <x:Double x:Key="AppCardShadowDepth">2</x:Double>
            <x:Double x:Key="AppCardShadowBlurRadius">10</x:Double>
            <ThemeShadow x:Key="AppCardShadow" />
            <SolidColorBrush x:Key="AppToastBrush" Color="#0F172A" Opacity="0.94" />

            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource AppPrimaryTextBrush}" />
            </Style>
            <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource AppPrimaryTextBrush}" />
            </Style>
            <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource AppBodyTextBrush}" />
            </Style>
            <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource AppPlaceholderTextBrush}" />
            </Style>
            <Style x:Key="SectionBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="InsetBorderStyle" TargetType="Border" BasedOn="{StaticResource SectionBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource AppSurfaceInsetBrush}" />
            </Style>
            <Style x:Key="CardBorderStyle" TargetType="Border" BasedOn="{StaticResource SectionBorderStyle}">
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="PillBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppSurfaceInsetBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,3" />
            </Style>
            <Style x:Key="ToastContainerStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AppToastBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="MaxWidth" Value="360" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>
            <Style x:Key="ToastTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!-- WinUI 通过焦点画刷和线宽提供焦点态，效果等同于 WPF 的 FocusVisualStyle。 -->
            <Style x:Key="FocusVisualStyle" TargetType="Control">
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource AppFocusSecondaryBrush}" />
                <Setter Property="FocusVisualSecondaryThickness" Value="1" />
                <Setter Property="FocusVisualMargin" Value="2" />
            </Style>
            <Style x:Key="ToolButtonStyle" TargetType="Button">
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource AppFocusSecondaryBrush}" />
                <Setter Property="FocusVisualSecondaryThickness" Value="1" />
                <Setter Property="FocusVisualMargin" Value="2" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource AppFocusSecondaryBrush}" />
                <Setter Property="FocusVisualSecondaryThickness" Value="1" />
                <Setter Property="FocusVisualMargin" Value="2" />
                <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource AppFocusSecondaryBrush}" />
                <Setter Property="FocusVisualSecondaryThickness" Value="1" />
                <Setter Property="FocusVisualMargin" Value="2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
            <local:FactCategoryDisplayConverter x:Key="FactCategoryConverter" />
            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <DataTemplate x:Key="FactCategoryItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource FactCategoryConverter}}" />
            </DataTemplate>
            <Style TargetType="NavigationView">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="IsPaneToggleButtonVisible" Value="True" />
                <Setter Property="CompactPaneLength" Value="48" />
                <Setter Property="OpenPaneLength" Value="232" />
            </Style>
            <Style TargetType="NavigationViewItem">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Margin" Value="4,2" />
                <Setter Property="MinHeight" Value="40" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource AppFocusSecondaryBrush}" />
                <Setter Property="FocusVisualSecondaryThickness" Value="1" />
                <Setter Property="FocusVisualMargin" Value="2" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource AppBodyTextBrush}" />
                <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource AppFocusSecondaryBrush}" />
                <Setter Property="FocusVisualSecondaryThickness" Value="1" />
                <Setter Property="FocusVisualMargin" Value="2" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource AppBodyTextBrush}" />
                <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource AppFocusSecondaryBrush}" />
                <Setter Property="FocusVisualSecondaryThickness" Value="1" />
                <Setter Property="FocusVisualMargin" Value="2" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
            <Style TargetType="ListView">
                <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style TargetType="InfoBar">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="IsClosable" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
