<Page
    x:Class="BossFind.App.Views.BossBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    NavigationCacheMode="Required"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    SizeChanged="OnPageSizeChanged">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="BrowserSubtleSurfaceBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="BrowserWarningSurfaceBrush" Color="#FFFBEB" />
                    <SolidColorBrush x:Key="BrowserWarningBorderBrush" Color="#FCD34D" />
                    <SolidColorBrush x:Key="BrowserWarningTextBrush" Color="#D97706" />
                    <SolidColorBrush x:Key="BrowserInfoSurfaceBrush" Color="#EFF6FF" />
                    <SolidColorBrush x:Key="BrowserInfoBorderBrush" Color="#BFDBFE" />
                    <SolidColorBrush x:Key="BrowserSuccessSurfaceBrush" Color="#ECFDF5" />
                    <SolidColorBrush x:Key="BrowserSuccessBorderBrush" Color="#A7F3D0" />
                    <SolidColorBrush x:Key="BrowserSuccessTextBrush" Color="#047857" />
                    <SolidColorBrush x:Key="BrowserMissingSurfaceBrush" Color="#FFF7ED" />
                    <SolidColorBrush x:Key="BrowserMissingBorderBrush" Color="#FED7AA" />
                    <SolidColorBrush x:Key="BrowserMissingTextBrush" Color="#C2410C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BrowserSubtleSurfaceBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="BrowserWarningSurfaceBrush" Color="#FFFBEB" />
                    <SolidColorBrush x:Key="BrowserWarningBorderBrush" Color="#FCD34D" />
                    <SolidColorBrush x:Key="BrowserWarningTextBrush" Color="#D97706" />
                    <SolidColorBrush x:Key="BrowserInfoSurfaceBrush" Color="#EFF6FF" />
                    <SolidColorBrush x:Key="BrowserInfoBorderBrush" Color="#BFDBFE" />
                    <SolidColorBrush x:Key="BrowserSuccessSurfaceBrush" Color="#ECFDF5" />
                    <SolidColorBrush x:Key="BrowserSuccessBorderBrush" Color="#A7F3D0" />
                    <SolidColorBrush x:Key="BrowserSuccessTextBrush" Color="#047857" />
                    <SolidColorBrush x:Key="BrowserMissingSurfaceBrush" Color="#FFF7ED" />
                    <SolidColorBrush x:Key="BrowserMissingBorderBrush" Color="#FED7AA" />
                    <SolidColorBrush x:Key="BrowserMissingTextBrush" Color="#C2410C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BrowserSubtleSurfaceBrush" Color="#27313D" />
                    <SolidColorBrush x:Key="BrowserWarningSurfaceBrush" Color="#3A2F17" />
                    <SolidColorBrush x:Key="BrowserWarningBorderBrush" Color="#8A6A20" />
                    <SolidColorBrush x:Key="BrowserWarningTextBrush" Color="#F6C453" />
                    <SolidColorBrush x:Key="BrowserInfoSurfaceBrush" Color="#1B3154" />
                    <SolidColorBrush x:Key="BrowserInfoBorderBrush" Color="#3569AB" />
                    <SolidColorBrush x:Key="BrowserSuccessSurfaceBrush" Color="#173A2B" />
                    <SolidColorBrush x:Key="BrowserSuccessBorderBrush" Color="#2D7D5B" />
                    <SolidColorBrush x:Key="BrowserSuccessTextBrush" Color="#7DE3B2" />
                    <SolidColorBrush x:Key="BrowserMissingSurfaceBrush" Color="#3A2919" />
                    <SolidColorBrush x:Key="BrowserMissingBorderBrush" Color="#8A5A2B" />
                    <SolidColorBrush x:Key="BrowserMissingTextBrush" Color="#FDBA74" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        <Style x:Key="SidebarCardStyle" TargetType="Border" BasedOn="{StaticResource SectionBorderStyle}">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style x:Key="SidebarSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SidebarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource AppMutedTextBrush}" />
        </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}" RowDefinitions="Auto,Auto,*,Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="BrowserSplit.DisplayMode" Value="Inline" /></VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="BrowserSplit.DisplayMode" Value="Overlay" /></VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid Padding="12,8" RowDefinitions="Auto,Auto" RowSpacing="8" Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button Click="OnBackClick" IsEnabled="{Binding CanGoBack}" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="后退">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <Button.KeyboardAccelerators><KeyboardAccelerator Modifiers="Menu" Key="Left" /></Button.KeyboardAccelerators>
                    </Button>
                    <Button Click="OnForwardClick" IsEnabled="{Binding CanGoForward}" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="前进">
                        <FontIcon Glyph="&#xE72A;" FontSize="14" />
                        <Button.KeyboardAccelerators><KeyboardAccelerator Modifiers="Menu" Key="Right" /></Button.KeyboardAccelerators>
                    </Button>
                    <Button Click="OnReloadStopClick" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="刷新 / 停止">
                        <Grid>
                            <FontIcon Glyph="&#xE72C;" FontSize="14" Visibility="{x:Bind viewModel.ShowReloadIcon, Mode=OneWay}" />
                            <FontIcon Glyph="&#xE71A;" FontSize="14" Visibility="{x:Bind viewModel.ShowStopIcon, Mode=OneWay}" />
                        </Grid>
                        <Button.KeyboardAccelerators><KeyboardAccelerator Key="F5" /><KeyboardAccelerator Modifiers="Control" Key="R" /></Button.KeyboardAccelerators>
                    </Button>
                    <Button Click="OnZoomOutClick" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="缩小"><FontIcon Glyph="&#xE738;" FontSize="14" /></Button>
                    <Button Click="OnZoomResetClick" Content="{Binding ZoomText}" MinWidth="52" Padding="4,0" ToolTipService.ToolTip="重置缩放" />
                    <Button Click="OnZoomInClick" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="放大"><FontIcon Glyph="&#xE710;" FontSize="14" /></Button>
                    <Border Width="1" Height="22" Background="{ThemeResource AppDividerBrush}" Margin="4,0" VerticalAlignment="Center" />
                    <Button Click="OnSavePostingClick" IsEnabled="{x:Bind viewModel.IsSummaryReady, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" ToolTipService.ToolTip="记录当前岗位">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="记录" /></StackPanel>
                    </Button>
                    <Button Click="OnSaveSearchResultsClick" IsEnabled="{x:Bind viewModel.HasSearchResults, Mode=OneWay}" Style="{StaticResource QuietButtonStyle}" ToolTipService.ToolTip="保存搜索结果">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;" FontSize="13" /><TextBlock Text="保存结果" /></StackPanel>
                    </Button>
                    <ToggleButton x:Name="PaneToggleButton" Click="OnPaneToggleClick" Padding="12,7" VerticalAlignment="Center" Background="{ThemeResource AppAccentBrush}" Foreground="White" BorderBrush="{ThemeResource AppAccentBrush}" ToolTipService.ToolTip="显示或隐藏岗位信息">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8A7;" FontSize="13" /><TextBlock Text="岗位信息" /></StackPanel>
                    </ToggleButton>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Background="{ThemeResource BrowserSubtleSurfaceBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,0">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="{ThemeResource AppMutedTextBrush}" Margin="0,0,7,0" />
                    <TextBox x:Name="UrlBox" Grid.Column="1" PlaceholderText="输入网址，回车打开" Text="https://www.zhipin.com/" KeyDown="OnUrlKeyDown" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="34">
                        <TextBox.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="L" Invoked="OnFocusUrlAccelerator" /></TextBox.KeyboardAccelerators>
                    </TextBox>
                </Grid>
            </Border>
            <Button Grid.Row="1" HorizontalAlignment="Right" Click="OnOpenExternalClick" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="在默认浏览器打开" Margin="0,0,4,0">
                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
            </Button>
        </Grid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" Visibility="{x:Bind viewModel.IsLoading, Mode=OneWay}" />

        <SplitView Grid.Row="2" x:Name="BrowserSplit" PanePlacement="Right" DisplayMode="Inline" OpenPaneLength="420" IsPaneOpen="True">
            <WebView2 x:Name="BossWebView" />
            <SplitView.Pane>
                <Grid Background="{ThemeResource AppBackgroundBrush}" MinWidth="380">
                    <ScrollViewer x:Name="DetailsPanel" Padding="10,10,8,14" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding JobTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{x:Bind viewModel.ShowSummary, Mode=OneWay}" />
                                    <TextBlock Text="{Binding PageTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{x:Bind viewModel.ShowSummaryHint, Mode=OneWay}" />
                                    <TextBlock Text="{Binding Company}" Foreground="{ThemeResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding City}" Foreground="{ThemeResource AppMutedTextBrush}" FontSize="12" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{ThemeResource AppSurfaceRaisedBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7,4" VerticalAlignment="Top" ToolTipService.ToolTip="当前页面">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" Foreground="{ThemeResource AppMutedTextBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding CurrentUrl}" FontSize="10" Foreground="{ThemeResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" />

                            <Border Style="{StaticResource SidebarCardStyle}">
                                <StackPanel Spacing="7">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="岗位摘要" FontWeight="SemiBold" />
                                    </Grid>
                                    <Border Background="{ThemeResource BrowserWarningSurfaceBrush}" BorderBrush="{ThemeResource BrowserWarningBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9,7" Visibility="{x:Bind viewModel.ShowSummaryHint, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource BrowserWarningTextBrush}" VerticalAlignment="Top" />
                                            <TextBlock Text="打开岗位详情后显示摘要" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource BrowserWarningTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Spacing="6" Visibility="{x:Bind viewModel.ShowSummary, Mode=OneWay}">
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                            <StackPanel Spacing="2"><TextBlock Text="薪资" Style="{StaticResource SidebarLabelStyle}" /><TextBlock Text="{Binding Salary}" TextWrapping="Wrap" Foreground="{ThemeResource BrowserWarningTextBrush}" FontWeight="SemiBold" /></StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="经验" Style="{StaticResource SidebarLabelStyle}" /><TextBlock Text="{Binding Experience}" TextWrapping="Wrap" /></StackPanel>
                                            <StackPanel Grid.Row="1" Spacing="2"><TextBlock Text="学历" Style="{StaticResource SidebarLabelStyle}" /><TextBlock Text="{Binding Education}" TextWrapping="Wrap" /></StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2"><TextBlock Text="福利" Style="{StaticResource SidebarLabelStyle}" /><TextBlock Text="{Binding Benefits}" TextWrapping="Wrap" /></StackPanel>
                                        </Grid>
                                        <Border Background="{ThemeResource BrowserInfoSurfaceBrush}" BorderBrush="{ThemeResource BrowserInfoBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" HorizontalAlignment="Left" MaxWidth="280">
                                            <TextBlock Text="{Binding Tags}" TextWrapping="Wrap" Foreground="{ThemeResource AppAccentBrush}" FontSize="12" />
                                        </Border>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" FontSize="12" />
                                        <TextBlock Text="{Binding JobQualityText}" Foreground="{ThemeResource AppAccentBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding JobRiskFlagsText}" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{ThemeResource AppWarningBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SidebarCardStyle}">
                                <StackPanel Spacing="7">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="操作" FontWeight="SemiBold" />
                                    </Grid>
                                    <ComboBox Header="简历" Height="36" ItemsSource="{Binding CandidateProfiles}" SelectedItem="{Binding SelectedCandidateProfile, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="请选择" />
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <Button Click="OnSavePostingClick" IsEnabled="{Binding IsSummaryReady}" Style="{StaticResource SidebarSecondaryButtonStyle}" ToolTipService.ToolTip="记录岗位">
                                            <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE710;" FontSize="12" /><TextBlock Text="记录" /></StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Click="OnFavoriteClick" IsEnabled="{Binding IsSummaryReady}" Style="{StaticResource SidebarSecondaryButtonStyle}" ToolTipService.ToolTip="收藏岗位">
                                            <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE734;" FontSize="12" /><TextBlock Text="{Binding FavoriteActionLabel}" /></StackPanel>
                                        </Button>
                                        <Button Grid.Row="1" Click="OnMatchClick" IsEnabled="{Binding IsSummaryReady}" Style="{StaticResource SidebarPrimaryButtonStyle}" ToolTipService.ToolTip="分析简历与岗位的匹配度">
                                            <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE9D9;" FontSize="12" /><TextBlock Text="匹配" /></StackPanel>
                                        </Button>
                                        <Button Grid.Row="1" Grid.Column="1" Click="OnGenerateGreetingClick" IsEnabled="{Binding IsSummaryReady}" Style="{StaticResource SidebarPrimaryButtonStyle}" ToolTipService.ToolTip="生成定制打招呼语">
                                            <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE8BD;" FontSize="12" /><TextBlock Text="打招呼" /></StackPanel>
                                        </Button>
                                        <Button Grid.Row="2" Click="OnOpenOnlineResumeClick" Style="{StaticResource SidebarSecondaryButtonStyle}" ToolTipService.ToolTip="打开在线简历工作区">
                                            <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE77B;" FontSize="12" /><TextBlock Text="在线简历" /></StackPanel>
                                        </Button>
                                        <Button Grid.Row="2" Grid.Column="1" Click="OnApplyClick" IsEnabled="{Binding IsSummaryReady}" Style="{StaticResource SidebarPrimaryButtonStyle}" ToolTipService.ToolTip="打开投递页">
                                            <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE8FB;" FontSize="12" /><TextBlock Text="投递" /></StackPanel>
                                        </Button>
                                        <Button Grid.Row="3" Grid.ColumnSpan="2" Click="OnInsightClick" IsEnabled="{Binding IsSummaryReady}" Style="{StaticResource SidebarSecondaryButtonStyle}" ToolTipService.ToolTip="查看岗位分析">
                                            <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE9D5;" FontSize="12" /><TextBlock Text="分析" /></StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SidebarCardStyle}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="结果" FontWeight="SemiBold" />
                                        <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="9,3">
                                            <TextBlock Text="{Binding SelectedMatchScoreText}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentBrush}" />
                                        </Border>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="打招呼" Style="{StaticResource SidebarLabelStyle}" /><Button Grid.Column="1" Click="OnCopyGreetingClick" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="复制" Width="28" Height="28" MinHeight="28" Padding="0"><FontIcon Glyph="&#xE8C8;" FontSize="12" /></Button></Grid>
                                            <TextBox Text="{Binding GreetingText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="64" Background="{ThemeResource AppSurfaceInsetBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{Binding SelectedMatchExplanation}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppMutedTextBrush}" FontSize="11" />
                                            <TextBlock Text="{Binding SelectedMatchedSkillsText}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource BrowserSuccessTextBrush}" FontSize="11" />
                                            <TextBlock Text="{Binding SelectedMissingSkillsText}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource BrowserMissingTextBrush}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <primitives:Thumb x:Name="PaneResizeThumb" Width="8" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" DragDelta="OnPaneResizeThumbDragDelta" ToolTipService.ToolTip="拖动调整面板宽度" />
                </Grid>
            </SplitView.Pane>
        </SplitView>

        <Grid Grid.Row="3" Padding="12,5" ColumnDefinitions="*,Auto" Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Page>
