<Page
    x:Class="BossFind.App.Views.CandidateProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <Grid Padding="24" RowDefinitions="Auto,*" ColumnDefinitions="260,*" ColumnSpacing="24" RowSpacing="18">
        <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="候选人档案" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="维护候选人资料、经历和技能记录。" Foreground="{ThemeResource AppMutedTextBrush}" />
            </StackPanel>
            <ProgressRing Grid.Column="1" Width="22" Height="22" IsActive="{Binding IsBusy}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="新建档案" Click="OnNewProfileClick" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
            <TextBlock Text="档案列表" FontWeight="SemiBold" />
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox
                    x:Name="SearchTextBox"
                    PlaceholderText="搜索姓名、职位或地点"
                    Text="{Binding SearchText, Mode=TwoWay}"
                    KeyDown="OnSearchKeyDown" />
                <Button Grid.Column="1" Content="搜索" Click="OnSearchClick" Padding="9,6" />
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding SearchResultMessage}" Foreground="{ThemeResource AppMutedTextBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="清除" Click="OnClearSearchClick" Padding="8,4" />
            </Grid>
            <ListView
                x:Name="ProfilesList"
                Grid.Row="3"
                ItemsSource="{Binding Profiles}"
                SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                SelectionChanged="OnProfileSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="4,9" Spacing="3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Headline}" Foreground="{ThemeResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Location}" Foreground="{ThemeResource AppMutedTextBrush}" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="基本信息" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox Header="姓名" Text="{Binding Name, Mode=TwoWay}" />
                    <TextBox Header="当前职位 / 标题" Text="{Binding Headline, Mode=TwoWay}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <TextBox Header="所在地" Text="{Binding Location, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Header="电话" Text="{Binding Phone, Mode=TwoWay}" />
                    </Grid>
                    <TextBox Header="邮箱" Text="{Binding Email, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="保存档案" Click="OnSaveProfileClick" />
                        <Button Content="删除档案" Click="OnDeleteProfileClick" IsEnabled="{Binding CanDeleteProfile}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{ThemeResource AppMutedTextBrush}" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource AppBorderBrush}" />

                <StackPanel Spacing="12">
                    <TextBlock Text="经历与技能" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox
                        Header="类别"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedFactCategory, Mode=TwoWay}"
                        HorizontalAlignment="Left"
                        MinWidth="200" />
                    <TextBox Header="事实内容" Text="{Binding FactContent, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBox Header="来源" Text="{Binding FactSourceText, Mode=TwoWay}" />
                        <NumberBox
                            Grid.Column="1"
                            Header="置信度"
                            Width="110"
                            Minimum="0"
                            Maximum="1"
                            SmallChange="0.1"
                            Value="{Binding FactConfidence, Mode=TwoWay}" />
                    </Grid>
                    <CheckBox Content="已确认" IsChecked="{Binding FactIsConfirmed, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{Binding FactActionLabel}" Click="OnSaveFactClick" />
                        <Button Content="取消编辑" Click="OnCancelFactClick" IsEnabled="{Binding IsEditingFact}" />
                    </StackPanel>
                    <ListView ItemsSource="{Binding Facts}" MaxHeight="320">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,9" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Category}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SourceText}" Foreground="{ThemeResource AppMutedTextBrush}" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                        <Button Content="编辑" Tag="{Binding}" Click="OnEditFactClick" Padding="8,4" />
                                        <Button Content="删除" Tag="{Binding}" Click="OnDeleteFactClick" Padding="8,4" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
