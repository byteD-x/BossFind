<Page
    x:Class="BossFind.App.Views.JobsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    SizeChanged="OnPageSizeChanged">
    <Page.Resources>
        <Style x:Key="JobListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid x:Name="Root" Background="Transparent">
                            <Rectangle x:Name="SelectionIndicator" Width="4" Fill="{ThemeResource AppAccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Stretch" Opacity="0" />
                            <ListViewItemPresenter x:Name="Presenter"
                                Margin="4,0,0,0"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{ThemeResource AppDividerBrush}"
                                BorderThickness="0,0,0,1"
                                SelectedBackground="#EFF6FF"
                                SelectedPointerOverBackground="#E5F0FF"
                                PointerOverBackground="{ThemeResource AppSurfaceRaisedBrush}"
                                SelectionCheckMarkVisualEnabled="False" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters><Setter Target="SelectionIndicator.Opacity" Value="1" /></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedUnfocused">
                                        <VisualState.Setters><Setter Target="SelectionIndicator.Opacity" Value="1" /></VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailsMetaLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource AppMutedTextBrush}" />
        </Style>
        <Style x:Key="FooterButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageLayout" Background="{ThemeResource AppBackgroundBrush}" Padding="24" RowDefinitions="Auto,*" ColumnDefinitions="320,*" ColumnSpacing="20" RowSpacing="16">
        <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
                <TextBlock Text="岗位记录" Style="{StaticResource TitleTextBlockStyle}" FontSize="24" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Border x:Name="ListPanel" Grid.Row="1" Grid.Column="0" Style="{StaticResource SectionBorderStyle}" Padding="10">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                <Border Background="#F8FAFC" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,0">
                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource AppMutedTextBrush}" Margin="0,0,7,0" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="搜索岗位、公司、城市或技能" TextChanged="OnSearchTextChanged" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="34" />
                    </Grid>
                </Border>
                <ComboBox Grid.Row="1" Header="筛选" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="150" />
                <Grid Grid.Row="2" RowDefinitions="*,Auto">
                    <ListView x:Name="JobsListView" ItemsSource="{Binding FilteredPostings}" SelectedItem="{Binding SelectedPosting, Mode=TwoWay}" SelectionMode="Single" ItemContainerStyle="{StaticResource JobListItemStyle}" BorderThickness="0" CornerRadius="0" Padding="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,11,8,10" ColumnDefinitions="*,Auto" MinHeight="86">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="收藏岗位" Tag="{Binding}" Click="OnContextFavoriteClick" />
                                            <MenuFlyoutItem Text="加入复核" Tag="{Binding}" Click="OnContextQueueClick" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE77B;" FontSize="12" Foreground="{ThemeResource AppMutedTextBrush}" />
                                            <TextBlock Text="{Binding Company}" Foreground="{ThemeResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding City}" Foreground="{ThemeResource AppMutedTextBrush}" FontSize="12" />
                                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="5,1" MaxWidth="170">
                                                <TextBlock Text="{Binding Skills}" Foreground="{ThemeResource AppAccentBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Salary}" Foreground="#D97706" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top" TextAlignment="Right" MaxWidth="90" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}" TextWrapping="Wrap" Foreground="{ThemeResource AppMutedTextBrush}" Margin="8,12,8,0" />
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="DetailsPanel" Grid.Row="1" Grid.Column="1" RowDefinitions="*,Auto">
            <ScrollViewer x:Name="DetailsScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource SectionBorderStyle}" Padding="20" Margin="0,0,0,12">
                    <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding SelectedPosting.Title}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="20" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="13" Foreground="{ThemeResource AppAccentBrush}" />
                                    <TextBlock Text="{Binding SelectedPosting.Company}" Foreground="{ThemeResource AppMutedTextBrush}" />
                                    <TextBlock Text="已认证" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPosting.Salary}" Foreground="#D97706" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Top" TextAlignment="Right" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="24">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE707;" FontSize="13" Foreground="{ThemeResource AppMutedTextBrush}" /><TextBlock Text="{Binding SelectedPosting.City}" Style="{StaticResource DetailsMetaLabelStyle}" /></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE821;" FontSize="13" Foreground="{ThemeResource AppMutedTextBrush}" /><TextBlock Text="{Binding SelectedPosting.Experience}" Style="{StaticResource DetailsMetaLabelStyle}" /></StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7BE;" FontSize="13" Foreground="{ThemeResource AppMutedTextBrush}" /><TextBlock Text="{Binding SelectedPosting.Education}" Style="{StaticResource DetailsMetaLabelStyle}" /></StackPanel>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="技能" Style="{StaticResource DetailsMetaLabelStyle}" />
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="9,5" HorizontalAlignment="Left" MaxWidth="500">
                                <TextBlock Text="{Binding SelectedPosting.Skills}" TextWrapping="Wrap" Foreground="{ThemeResource AppAccentBrush}" />
                            </Border>
                        </StackPanel>
                        <Border Style="{StaticResource InsetBorderStyle}" Padding="12">
                            <StackPanel Spacing="5"><TextBlock Text="岗位描述" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedPosting.Description}" TextWrapping="Wrap" MaxHeight="300" /></StackPanel>
                        </Border>
                        <StackPanel Spacing="8">
                            <TextBlock Text="关联简历" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding CandidateProfiles}" SelectedItem="{Binding SelectedCandidateProfile, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="不关联简历" HorizontalAlignment="Left" MinWidth="240" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <Border Grid.Row="1" Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1,1,1,0" Padding="14,10">
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                    <Button Click="OnOpenPostingClick" IsEnabled="{Binding HasSelectedPosting}" Style="{StaticResource PrimaryButtonStyle}" Height="36" MinHeight="36">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8A7;" FontSize="13" /><TextBlock Text="打开岗位" /></StackPanel>
                    </Button>
                    <Button Grid.Column="1" Click="OnToggleFavoriteClick" IsEnabled="{Binding HasSelectedPosting}" Style="{StaticResource FooterButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE734;" FontSize="13" /><TextBlock Text="{Binding FavoriteActionLabel}" /></StackPanel>
                    </Button>
                    <Button Grid.Column="2" HorizontalAlignment="Left" Click="OnQueueClick" IsEnabled="{Binding HasSelectedPosting}" Style="{StaticResource FooterButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7C1;" FontSize="13" /><TextBlock Text="加入复核队列" /></StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
