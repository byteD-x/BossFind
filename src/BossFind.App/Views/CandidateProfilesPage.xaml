<Page
    x:Class="BossFind.App.Views.CandidateProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    SizeChanged="OnPageSizeChanged">
    <Grid x:Name="PageLayout" Background="{ThemeResource AppBackgroundBrush}" Padding="24" RowDefinitions="Auto,*" ColumnDefinitions="250,*" ColumnSpacing="16" RowSpacing="14">
        <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <StackPanel Spacing="2">
                <TextBlock Text="求职者简历" Style="{StaticResource TitleTextBlockStyle}" />
            </StackPanel>
            <ProgressRing Grid.Column="1" Width="20" Height="20" IsActive="{Binding IsBusy}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="导入文件" ToolTipService.ToolTip="支持 PDF、DOCX、TXT、MD 和 RTF" Click="OnImportDocumentClick" Style="{StaticResource QuietButtonStyle}" />
            <Button Grid.Column="3" Content="＋ 新建档案" Click="OnNewProfileClick" Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>

        <Border x:Name="ListPanel" Grid.Row="1" Grid.Column="0" Style="{StaticResource SectionBorderStyle}" Padding="10">
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="我的档案" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" />
                    <TextBlock Grid.Column="1" Text="{Binding SearchResultMessage}" Foreground="{ThemeResource AppMutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox x:Name="SearchTextBox" PlaceholderText="搜索姓名、职位、地点" Text="{Binding SearchText, Mode=TwoWay}" KeyDown="OnSearchKeyDown" />
                    <Button Grid.Column="1" Content="查找" Click="OnSearchClick" Style="{StaticResource QuietButtonStyle}" Padding="8,5" />
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding SearchResultMessage}" Foreground="{ThemeResource AppMutedTextBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Content="清除" Click="OnClearSearchClick" Style="{StaticResource QuietButtonStyle}" Padding="7,3" />
                </Grid>
                <ListView x:Name="ProfilesList" Grid.Row="3" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" SelectionChanged="OnProfileSelectionChanged" BorderThickness="0" Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Background="{ThemeResource AppSurfaceRaisedBrush}" Padding="0" Margin="0,3">
                                <Grid ColumnDefinitions="3,*" ColumnSpacing="9">
                                    <Border Background="{ThemeResource AppAccentBrush}" CornerRadius="3,0,0,3" />
                                    <StackPanel Grid.Column="1" Spacing="2" Padding="10,10,12,10">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Headline}" Foreground="{ThemeResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Location}" Foreground="{ThemeResource AppMutedTextBrush}" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                <StackPanel x:Name="ProfilesLoadingState" Grid.Row="3" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Width="120" Height="12" Background="{ThemeResource AppSurfaceRaisedBrush}" CornerRadius="6" />
                    <Border Width="190" Height="12" Background="{ThemeResource AppSurfaceRaisedBrush}" CornerRadius="6" />
                    <Border Width="150" Height="12" Background="{ThemeResource AppSurfaceRaisedBrush}" CornerRadius="6" />
                </StackPanel>
                <StackPanel x:Name="ProfilesEmptyState" Grid.Row="3" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Image Source="ms-appx:///Assets/empty-resume.svg" Width="120" Height="96" HorizontalAlignment="Center" />
                    <TextBlock Text="还没有求职者简历" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <Button Content="立即新建" Click="OnNewProfileClick" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="DetailsPanel" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="档案预览" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Headline}" Foreground="{ThemeResource AppMutedTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ProgressRing Grid.Column="1" Width="20" Height="20" IsActive="{Binding IsBusy}" VerticalAlignment="Top" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Spacing="2"><TextBlock Text="所在地" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" /><TextBlock Text="{Binding Location}" TextTrimming="CharacterEllipsis" /></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="联系方式" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" /><TextBlock Text="{Binding Phone}" TextTrimming="CharacterEllipsis" /></StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Email}" Foreground="{ThemeResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="档案内容" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="事实" Grid.Column="1" Foreground="{ThemeResource AppMutedTextBrush}" FontSize="12" /></Grid>
                        <ListView ItemsSource="{Binding Facts}" MaxHeight="330" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="0,8" Spacing="3">
                                        <TextBlock Text="{Binding Category, Converter={StaticResource FactCategoryConverter}}" Foreground="{ThemeResource AppAccentBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SourceText}" Foreground="{ThemeResource AppMutedTextBrush}" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Expander x:Name="EditorExpander" Header="管理档案" IsExpanded="False">
                    <Border Style="{StaticResource SectionBorderStyle}" Margin="0,8,0,0">
                        <StackPanel Spacing="9">
                            <TextBox Header="姓名" Text="{Binding Name, Mode=TwoWay}" />
                            <TextBox Header="职位 / 方向" Text="{Binding Headline, Mode=TwoWay}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><TextBox Header="所在地" Text="{Binding Location, Mode=TwoWay}" /><TextBox Grid.Column="1" Header="电话" Text="{Binding Phone, Mode=TwoWay}" /></Grid>
                            <TextBox Header="邮箱" Text="{Binding Email, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="保存" Click="OnSaveProfileClick" Style="{StaticResource PrimaryButtonStyle}" /><Button Content="删除" Click="OnDeleteProfileClick" IsEnabled="{Binding CanDeleteProfile}" Style="{StaticResource QuietButtonStyle}" /></StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{ThemeResource AppMutedTextBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander Header="管理档案内容" IsExpanded="False">
                    <Border Style="{StaticResource SectionBorderStyle}" Margin="0,8,0,0">
                        <StackPanel Spacing="9">
                            <ComboBox Header="类型" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedFactCategory, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="180" ItemTemplate="{StaticResource FactCategoryItemTemplate}" />
                            <TextBox Header="内容" Text="{Binding FactContent, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBox Header="来源" Text="{Binding FactSourceText, Mode=TwoWay}" /><NumberBox Grid.Column="1" Header="可信度" Width="100" Minimum="0" Maximum="1" SmallChange="0.1" Value="{Binding FactConfidence, Mode=TwoWay}" /></Grid>
                            <CheckBox Content="已确认" IsChecked="{Binding FactIsConfirmed, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{Binding FactActionLabel}" Click="OnSaveFactClick" Style="{StaticResource PrimaryButtonStyle}" /><Button Content="取消" Click="OnCancelFactClick" IsEnabled="{Binding IsEditingFact}" Style="{StaticResource QuietButtonStyle}" /></StackPanel>
                            <ItemsRepeater ItemsSource="{Binding Facts}"><ItemsRepeater.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Padding="0,7" BorderBrush="{ThemeResource AppDividerBrush}" BorderThickness="0,0,0,1"><TextBlock Text="{Binding Content}" TextWrapping="Wrap" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><Button Content="编辑" Tag="{Binding}" Click="OnEditFactClick" Style="{StaticResource QuietButtonStyle}" Padding="7,3" /><Button Content="删除" Tag="{Binding}" Click="OnDeleteFactClick" Style="{StaticResource QuietButtonStyle}" Padding="7,3" /></StackPanel></Grid></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="ProfileDetailsEmptyState" Grid.Row="1" Grid.Column="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <Image Source="ms-appx:///Assets/empty-resume.svg" Width="120" Height="120" HorizontalAlignment="Center" />
            <TextBlock Text="暂无档案" FontSize="16" Foreground="{ThemeResource AppMutedTextBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="点击右上角新建档案，或导入本地简历。" FontSize="14" Foreground="{ThemeResource AppMutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" />
            <Button Content="立即新建" Click="OnNewProfileClick" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
