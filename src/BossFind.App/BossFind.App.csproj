<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>BossFind.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BossFind.Application\BossFind.Application.csproj" />
    <ProjectReference Include="..\BossFind.Infrastructure\BossFind.Infrastructure.csproj" />
    <ProjectReference Include="..\BossFind.Platform.Boss\BossFind.Platform.Boss.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\WebView2\fixture.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\BossFindIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square44x44Logo.png;Assets\Square150x150Logo.png;Assets\StoreLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ExcludePlaywrightRuntimeFromPri"
          BeforeTargets="_GenerateProjectPriConfigurationFiles"
          DependsOnTargets="GetPackagingOutputs">
    <!-- Playwright runtime files are payloads, not WinUI resources. Their hashed file names contain '-' and
         are otherwise interpreted as invalid PRI qualifiers (PRI249). -->
    <ItemGroup>
      <_AppxLayoutAssetPackageFiles Include="@(PackagingOutputs)"
                                    Condition="$([System.String]::Copy('%(PackagingOutputs.TargetPath)').StartsWith('.playwright\', StringComparison.OrdinalIgnoreCase)) Or $([System.String]::Copy('%(PackagingOutputs.TargetPath)').StartsWith('BossFind.Platform.Boss\.playwright\', StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>
  </Target>
</Project>
