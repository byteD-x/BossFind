<Window
    x:Class="BossFind.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BossFind">
    <!-- 自定义标题栏占用第 0 行，内容区从第 1 行开始 -->
    <Grid x:Name="RootGrid" RowDefinitions="48,*">
        <Border
            x:Name="AppTitleBar"
            Background="Transparent"
            VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="20" Height="20" />
                <TextBlock Text="BossFind" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock
                    Text="本地求职工作区"
                    FontSize="11"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource AppMutedTextBrush}"
                    Margin="6,1,0,0" />
            </StackPanel>
        </Border>
        <NavigationView
            x:Name="RootNavigationView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            ItemInvoked="OnNavigationItemInvoked">
            <NavigationView.PaneHeader>
                <StackPanel Padding="18,6,18,14" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="28" Height="28" CornerRadius="5" Background="{ThemeResource AppSurfaceRaisedBrush}">
                            <TextBlock Text="BF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="BossFind" Foreground="{ThemeResource AppAccentBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="本地招聘工作台" FontSize="10" Foreground="{ThemeResource AppMutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="工作区" IsHitTestVisible="False" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" />
                <NavigationViewItem Content="工作台" Tag="dashboard">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Boss 直聘浏览器" Tag="browser">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="岗位记录" Tag="jobs">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Save" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="候选人档案库" Tag="profiles">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="投递与复核" Tag="applications">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Send" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="岗位分析" Tag="insights">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Important" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.Header>
                <Grid Padding="20,10" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding CurrentPageTitle}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="档案与岗位记录保存在此设备" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="本地模式" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                </Grid>
            </NavigationView.Header>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
