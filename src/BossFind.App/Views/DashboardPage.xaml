<Page
    x:Class="BossFind.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <ScrollViewer Background="{ThemeResource AppBackgroundBrush}">
        <StackPanel Margin="28" Spacing="24">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="工作台" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="本地档案与岗位进度" Foreground="{ThemeResource AppMutedTextBrush}" />
                </StackPanel>
                <ProgressRing Grid.Column="1" Width="22" Height="22" IsActive="{Binding IsBusy}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="候选人档案" Click="OnOpenProfilesClick" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="刷新" Click="OnRefreshClick" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                <StackPanel Spacing="5">
                    <TextBlock Text="候选人档案" Foreground="{ThemeResource AppMutedTextBrush}" />
                    <TextBlock Text="{Binding ProfileCount}" FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="已确认事实" Foreground="{ThemeResource AppMutedTextBrush}" />
                    <TextBlock Text="{Binding ConfirmedFactCount}" FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="5">
                    <TextBlock Text="已记录岗位" Foreground="{ThemeResource AppMutedTextBrush}" />
                    <TextBlock Text="{Binding SavedJobCount}" FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="5">
                    <TextBlock Text="待处理事项" Foreground="{ThemeResource AppMutedTextBrush}" />
                    <TextBlock Text="{Binding PendingActionCount}" FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="2*,*" ColumnSpacing="32">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,8" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="最近查看的岗位" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button Grid.Column="1" Content="查看全部" Click="OnOpenJobsClick" Padding="8,4" />
                    </Grid>
                    <ItemsRepeater ItemsSource="{Binding RecentPostings}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,10" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Company}" Foreground="{ThemeResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="打开岗位" Tag="{Binding Url}" Click="OnOpenPostingClick" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Text="{Binding EmptyJobsMessage}" TextWrapping="Wrap" Foreground="{ThemeResource AppMutedTextBrush}" />
                    <Button Content="打开招聘浏览器" Click="OnOpenBrowserClick" HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Text="运行环境" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ItemsRepeater ItemsSource="{Binding ReadinessItems}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="5" Padding="0,2">
                                    <TextBlock Text="{Binding Name}" Foreground="{ThemeResource AppMutedTextBrush}" />
                                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Text="数据库和候选人信息保存在此设备。" TextWrapping="Wrap" Foreground="{ThemeResource AppMutedTextBrush}" />
                    <Button Content="查看投递与复核" Click="OnOpenApplicationsClick" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{ThemeResource AppMutedTextBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
