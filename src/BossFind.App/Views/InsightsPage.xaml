<Page
    x:Class="BossFind.App.Views.InsightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <ScrollViewer>
        <StackPanel Margin="28" Spacing="22">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="岗位分析" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="检查岗位信息，并按候选人档案计算技能匹配。" Foreground="{ThemeResource AppMutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource AppMutedTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="12" VerticalAlignment="Bottom">
                <ComboBox Header="岗位" ItemsSource="{Binding Postings}" SelectedItem="{Binding SelectedPosting, Mode=TwoWay}" DisplayMemberPath="Title" />
                <ComboBox Grid.Column="1" Header="候选人档案（可选）" ItemsSource="{Binding CandidateProfiles}" SelectedItem="{Binding SelectedCandidateProfile, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="不匹配档案" />
                <Button Grid.Column="2" Content="分析岗位" Click="OnAnalyzeClick" IsEnabled="{Binding HasSelectedPosting}" VerticalAlignment="Bottom" />
            </Grid>

            <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" Foreground="{ThemeResource AppMutedTextBrush}" />

            <StackPanel Spacing="8">
                <TextBlock Text="岗位信息" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                <ItemsRepeater ItemsSource="{Binding Suggestions}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*" Padding="0,6" ColumnSpacing="8">
                                <Ellipse Width="6" Height="6" Fill="{ThemeResource AppWarningBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="候选人匹配" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{Binding MatchSummary}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                    <StackPanel Spacing="4">
                        <TextBlock Text="命中技能" Foreground="{ThemeResource AppMutedTextBrush}" />
                        <TextBlock Text="{Binding MatchedSkills}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="待补充技能" Foreground="{ThemeResource AppMutedTextBrush}" />
                        <TextBlock Text="{Binding MissingSkills}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
