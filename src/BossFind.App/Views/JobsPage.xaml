<Page
    x:Class="BossFind.App.Views.JobsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <Grid Padding="28" RowDefinitions="Auto,*" ColumnDefinitions="320,*" ColumnSpacing="28" RowSpacing="18">
        <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="岗位记录" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="浏览过的岗位和收藏状态" Foreground="{ThemeResource AppMutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource AppMutedTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <TextBox x:Name="SearchBox" PlaceholderText="搜索岗位、公司、城市或技能" TextChanged="OnSearchTextChanged" />
            <ComboBox Grid.Row="1" Header="筛选" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="150" />
            <ListView Grid.Row="2" ItemsSource="{Binding FilteredPostings}" SelectedItem="{Binding SelectedPosting, Mode=TwoWay}" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8,10" Spacing="3">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Company}" Foreground="{ThemeResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding City}" Foreground="{ThemeResource AppMutedTextBrush}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Salary}" Foreground="{ThemeResource AppAccentBrush}" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Grid.Row="2" Text="{Binding EmptyMessage}" TextWrapping="Wrap" Foreground="{ThemeResource AppMutedTextBrush}" VerticalAlignment="Top" Margin="8,12" IsHitTestVisible="False" />
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding SelectedPosting.Title}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedPosting.Company}" Foreground="{ThemeResource AppMutedTextBrush}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="12">
                    <StackPanel Spacing="3"><TextBlock Text="地点" Foreground="{ThemeResource AppMutedTextBrush}" /><TextBlock Text="{Binding SelectedPosting.City}" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="薪资" Foreground="{ThemeResource AppMutedTextBrush}" /><TextBlock Text="{Binding SelectedPosting.Salary}" /></StackPanel>
                    <StackPanel Grid.Row="1" Spacing="3"><TextBlock Text="经验" Foreground="{ThemeResource AppMutedTextBrush}" /><TextBlock Text="{Binding SelectedPosting.Experience}" /></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3"><TextBlock Text="学历" Foreground="{ThemeResource AppMutedTextBrush}" /><TextBlock Text="{Binding SelectedPosting.Education}" /></StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="3"><TextBlock Text="技能" Foreground="{ThemeResource AppMutedTextBrush}" /><TextBlock Text="{Binding SelectedPosting.Skills}" TextWrapping="Wrap" /></StackPanel>
                </Grid>

                <TextBlock Text="{Binding SelectedPosting.Description}" TextWrapping="Wrap" MaxHeight="220" />

                <StackPanel Spacing="8">
                    <TextBlock Text="关联候选人（可选）" Foreground="{ThemeResource AppMutedTextBrush}" />
                    <ComboBox ItemsSource="{Binding CandidateProfiles}" SelectedItem="{Binding SelectedCandidateProfile, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="不关联档案" HorizontalAlignment="Left" MinWidth="220" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="打开岗位" Click="OnOpenPostingClick" IsEnabled="{Binding HasSelectedPosting}" />
                    <Button Content="{Binding FavoriteActionLabel}" Click="OnToggleFavoriteClick" IsEnabled="{Binding HasSelectedPosting}" />
                    <Button Content="加入复核队列" Click="OnQueueClick" IsEnabled="{Binding HasSelectedPosting}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
