<Page
    x:Class="BossFind.App.Views.BossBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    SizeChanged="OnPageSizeChanged">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- 宽屏：信息面板内联在右侧；窄屏：面板以浮层覆盖网页 -->
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="BrowserSplit.DisplayMode" Value="Inline" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="BrowserSplit.DisplayMode" Value="Overlay" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- 浏览器工具栏 -->
        <Grid
            Padding="8,6"
            RowDefinitions="Auto,Auto"
            RowSpacing="6"
            Background="{ThemeResource AppSurfaceBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
            <ScrollViewer
                HorizontalScrollMode="Enabled"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollMode="Disabled"
                VerticalScrollBarVisibility="Hidden">
                <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Click="OnBackClick" IsEnabled="{Binding CanGoBack}" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="后退 (Alt+←)">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu" Key="Left" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Click="OnForwardClick" IsEnabled="{Binding CanGoForward}" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="前进 (Alt+→)">
                    <FontIcon Glyph="&#xE72A;" FontSize="14" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu" Key="Right" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Click="OnReloadStopClick" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="刷新 (F5) / 停止加载">
                    <Grid>
                        <FontIcon Glyph="&#xE72C;" FontSize="14" Visibility="{x:Bind viewModel.ShowReloadIcon, Mode=OneWay}" />
                        <FontIcon Glyph="&#xE71A;" FontSize="14" Visibility="{x:Bind viewModel.ShowStopIcon, Mode=OneWay}" />
                    </Grid>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                        <KeyboardAccelerator Modifiers="Control" Key="R" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Click="OnZoomOutClick" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="缩小网页">
                    <FontIcon Glyph="&#xE738;" FontSize="14" />
                </Button>
                <Button Click="OnZoomResetClick" Content="{Binding ZoomText}" MinWidth="52" Padding="4,0" ToolTipService.ToolTip="重置网页缩放" />
                <Button Click="OnZoomInClick" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="放大网页">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                </Button>
                <Button Content="示例岗位" Click="OnFixtureClick" VerticalAlignment="Center" Padding="10,6" />
                <ToggleButton
                    x:Name="PaneToggleButton"
                    Content="岗位信息"
                    Click="OnPaneToggleClick"
                    VerticalAlignment="Center"
                    Padding="10,6" />
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <TextBox
                    x:Name="UrlBox"
                    PlaceholderText="输入网址，回车打开"
                    Text="https://www.zhipin.com/"
                    VerticalAlignment="Center"
                    KeyDown="OnUrlKeyDown">
                    <TextBox.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="OnFocusUrlAccelerator" />
                    </TextBox.KeyboardAccelerators>
                </TextBox>
                <Button Grid.Column="1" Click="OnOpenExternalClick" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="在默认浏览器打开当前网页">
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                </Button>
            </Grid>
        </Grid>

        <!-- 加载进度 -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" Visibility="{x:Bind viewModel.IsLoading, Mode=OneWay}" />

        <!-- 网页 + 岗位信息面板 -->
        <SplitView
            Grid.Row="2"
            x:Name="BrowserSplit"
            PanePlacement="Right"
            DisplayMode="Inline"
            OpenPaneLength="380"
            IsPaneOpen="True">
            <WebView2 x:Name="BossWebView" />
            <SplitView.Pane>
                <ScrollViewer x:Name="DetailsPanel" Padding="16" VerticalScrollBarVisibility="Auto" Background="{ThemeResource AppBackgroundBrush}">
                    <StackPanel Spacing="12">
                        <!-- 当前网页信息 -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="当前网页" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{Binding PageTitle}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                            <TextBlock Text="{Binding CurrentUrl}" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>

                        <!-- 网页元信息：帮助用户确认当前嵌入页面，而不打断网页浏览 -->
                        <Border
                            Padding="14"
                            CornerRadius="8"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="网页信息" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{Binding PageSiteName}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PageMetaDescription}" TextWrapping="Wrap" Foreground="{ThemeResource AppMutedTextBrush}" />
                                <TextBlock Text="{Binding PageFaviconUrl}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" />
                                <TextBlock Text="{Binding PageCanonicalUrl}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" />
                                <TextBlock Text="{Binding PageKeywords}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" />
                                <TextBlock Text="{Binding PageAuthor}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" />
                                <TextBlock Text="{Binding PageLanguage}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" />
                                <TextBlock Text="{Binding PageStatsText}" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- 岗位摘要 -->
                        <Border
                            Padding="14"
                            CornerRadius="8"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="岗位摘要" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock
                                    Text="尚未识别到岗位信息。打开招聘平台的岗位详情页后，这里会自动展示网页中的标题、薪资、要求和福利。"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource AppMutedTextBrush}"
                                    Visibility="{x:Bind viewModel.ShowSummaryHint, Mode=OneWay}" />
                                <StackPanel Spacing="4" Visibility="{x:Bind viewModel.ShowSummary, Mode=OneWay}">
                                    <TextBlock Text="{Binding JobTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Company}" />
                                    <TextBlock Text="{Binding City}" Foreground="{ThemeResource AppMutedTextBrush}" />
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                        <StackPanel Spacing="2"><TextBlock Text="薪资" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" /><TextBlock Text="{Binding Salary}" TextWrapping="Wrap" /></StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="经验" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" /><TextBlock Text="{Binding Experience}" TextWrapping="Wrap" /></StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="2"><TextBlock Text="学历" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" /><TextBlock Text="{Binding Education}" TextWrapping="Wrap" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2"><TextBlock Text="福利" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" /><TextBlock Text="{Binding Benefits}" TextWrapping="Wrap" /></StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Tags}" TextWrapping="Wrap" Foreground="{ThemeResource AppAccentBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 岗位描述 -->
                        <Border
                            Padding="14"
                            CornerRadius="8"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            Visibility="{x:Bind viewModel.ShowSummary, Mode=OneWay}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="岗位描述" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <!-- 操作 -->
                        <Border
                            Padding="14"
                            CornerRadius="8"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="操作" FontSize="14" FontWeight="SemiBold" />
                                <ComboBox Header="候选人档案" ItemsSource="{Binding CandidateProfiles}" SelectedItem="{Binding SelectedCandidateProfile, Mode=TwoWay}" DisplayMemberPath="Name" />
                                <TextBox Header="新档案姓名" Text="{Binding CandidateName, Mode=TwoWay}" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                    <Button Content="{Binding FavoriteActionLabel}" Click="OnFavoriteClick" IsEnabled="{Binding IsSummaryReady}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="岗位分析" Click="OnInsightClick" IsEnabled="{Binding IsSummaryReady}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Row="1" Content="导出 PDF" Click="OnPdfClick" IsEnabled="{Binding IsSummaryReady}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Row="1" Grid.Column="1" Content="加入复核队列" Click="OnQueueClick" IsEnabled="{Binding IsSummaryReady}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Row="2" Content="导入候选人档案" Click="OnImportClick" IsEnabled="{Binding IsSummaryReady}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Row="2" Grid.Column="1" Content="匹配已有档案" Click="OnMatchClick" IsEnabled="{Binding IsSummaryReady}" HorizontalAlignment="Stretch" />
                                </Grid>
                                <Button Content="打开投递页" Click="OnApplyClick" IsEnabled="{Binding IsSummaryReady}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <!-- 候选人匹配 -->
                        <Border
                            Padding="14"
                            CornerRadius="8"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="候选人匹配" FontSize="14" FontWeight="SemiBold" />
                                    <ProgressRing Grid.Column="1" Width="20" Height="20" IsActive="{Binding IsBusy}" />
                                </Grid>
                                <TextBlock Text="{Binding MatchStatus}" TextWrapping="Wrap" Foreground="{ThemeResource AppMutedTextBrush}" FontSize="12" />
                                <ListView ItemsSource="{Binding Matches}" MaxHeight="280" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Padding="0,8" Spacing="3">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding Profile.Name}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ScoreText}" FontWeight="SemiBold" />
                                                </Grid>
                                                <TextBlock Text="{Binding Profile.Headline}" Foreground="{ThemeResource AppMutedTextBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding MatchedSkillsLabel}" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding MissingSkillsLabel}" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- 环境信息与隐私说明 -->
                        <TextBlock Text="{Binding ProfilePath}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" />
                        <TextBlock Text="登录信息保存在独立 WebView2 Profile。BossFind 不读取密码、Cookie 或验证码；投递和复核由你在平台页面手动完成。" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </SplitView.Pane>
        </SplitView>

        <!-- 状态栏 -->
        <Grid
            Grid.Row="3"
            Padding="12,4"
            ColumnDefinitions="*,Auto"
            Background="{ThemeResource AppSurfaceBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="工具栏调整网页缩放" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
