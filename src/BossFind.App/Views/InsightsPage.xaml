<Page
    x:Class="BossFind.App.Views.InsightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    SizeChanged="OnPageSizeChanged">
    <ScrollViewer Background="{ThemeResource AppBackgroundBrush}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" Spacing="18" MinWidth="680">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Text="岗位分析" Style="{StaticResource TitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource SectionBorderStyle}">
                <Grid x:Name="SelectorGrid" ColumnDefinitions="2*,*,Auto" ColumnSpacing="12" VerticalAlignment="Bottom">
                    <ComboBox Header="岗位" ItemsSource="{Binding Postings}" SelectedItem="{Binding SelectedPosting, Mode=TwoWay}" DisplayMemberPath="Title" />
                    <ComboBox Grid.Column="1" Header="简历（可选）" ItemsSource="{Binding CandidateProfiles}" SelectedItem="{Binding SelectedCandidateProfile, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="不匹配简历" />
                    <Button Grid.Column="2" Content="分析岗位" Click="OnAnalyzeClick" IsEnabled="{Binding HasSelectedPosting}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" Foreground="{ThemeResource AppMutedTextBrush}" />

            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel Spacing="5">
                    <TextBlock Text="JD 完整度与风险" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{Binding QualityScoreText}" Foreground="{ThemeResource AppAccentBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding QualityMissingText}" TextWrapping="Wrap" Foreground="{ThemeResource AppMutedTextBrush}" />
                    <TextBlock Text="{Binding QualityRiskText}" TextWrapping="Wrap" Foreground="{ThemeResource AppWarningBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="岗位信息" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                    <ItemsRepeater ItemsSource="{Binding Suggestions}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" Padding="0,6" ColumnSpacing="8"><Ellipse Width="6" Height="6" Fill="{ThemeResource AppWarningBrush}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" /></Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="简历匹配度" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{Binding MatchSummary}" TextWrapping="Wrap" />
                    <Grid x:Name="MatchGrid" ColumnDefinitions="*,*" ColumnSpacing="18">
                        <Border x:Name="MatchedPanel" Style="{StaticResource InsetBorderStyle}" Padding="12">
                            <StackPanel Spacing="5"><TextBlock Text="命中技能" Foreground="{ThemeResource AppGoodBrush}" FontWeight="SemiBold" /><TextBlock Text="{Binding MatchedSkills}" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border x:Name="MissingPanel" Grid.Column="1" Style="{StaticResource InsetBorderStyle}" Padding="12">
                            <StackPanel Spacing="5"><TextBlock Text="待补充技能" Foreground="{ThemeResource AppWarningBrush}" FontWeight="SemiBold" /><TextBlock Text="{Binding MissingSkills}" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
