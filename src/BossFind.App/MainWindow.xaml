<Window
    x:Class="BossFind.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BossFind">
    <Grid x:Name="RootGrid" RowDefinitions="48,*" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnNewProfileAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Enter" Invoked="OnSubmitAccelerator" />
        </Grid.KeyboardAccelerators>
        <Border
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="{ThemeResource AppSurfaceBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Padding="16,0,150,0" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="24" Height="24" />
                    <TextBlock Text="BossFind" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView
            x:Name="RootNavigationView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            ItemInvoked="OnNavigationItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="工作台" Tag="dashboard">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Boss 直聘浏览器" Tag="browser">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="岗位记录" Tag="jobs">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Save" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="求职者简历" Tag="profiles">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="在线简历" Tag="resume">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="投递与复核" Tag="applications">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Send" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <StackPanel x:Name="ToastHost" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Spacing="8" IsHitTestVisible="False" />
    </Grid>
</Window>
