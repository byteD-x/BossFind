<Page
    x:Class="BossFind.App.Views.ApplicationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    SizeChanged="OnPageSizeChanged">
    <Page.Resources>
        <DataTemplate x:Key="ApplicationRowTemplate">
            <Border Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppDividerBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                <Grid ColumnDefinitions="1.05*,1.2*,1.9*,1.05*,Auto,Auto" ColumnSpacing="10" MinHeight="48">
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="标记为已投递" Tag="{Binding}" Click="OnContextMarkSubmittedClick" />
                            <MenuFlyoutItem Text="更新状态" Tag="{Binding}" Click="OnContextUpdateStageClick" />
                            <MenuFlyoutItem Text="撤销记录" Tag="{Binding}" Click="OnContextWithdrawClick" />
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                    <TextBlock Text="{Binding Company}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding JobDescription}" Foreground="{ThemeResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding ResumeName}" Foreground="{ThemeResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border Grid.Column="4" Background="{ThemeResource AppSurfaceRaisedBrush}" BorderBrush="{ThemeResource AppBorderStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="7,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusLabel}" Foreground="{ThemeResource AppAccentBrush}" FontSize="12" />
                    </Border>
                    <Button Grid.Column="5" Content="更新" Tag="{Binding}" Click="OnApplicationRowActionClick" Style="{StaticResource QuietButtonStyle}" Padding="8,3" MinHeight="28" VerticalAlignment="Center" ToolTipService.ToolTip="选择这条投递记录并更新状态" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReviewTaskCardTemplate">
            <Border Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock Text="{Binding Company}" Foreground="{ThemeResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CreatedAtLabel}" Foreground="{ThemeResource AppMutedTextBrush}" FontSize="11" />
                    <TextBlock Text="{Binding StatusLabel}" Foreground="{ThemeResource AppAccentBrush}" FontSize="11" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}" Padding="24" RowDefinitions="Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
                <TextBlock Text="投递记录与复核" Style="{StaticResource TitleTextBlockStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ApplicationsColumns" Grid.Row="1" ColumnDefinitions="1.55*,1.05*" ColumnSpacing="16">
            <Border x:Name="ApplicationsPanel" Style="{StaticResource SectionBorderStyle}" Padding="14">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="投递台账" Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Applications.Count}" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="1" Background="{ThemeResource AppSurfaceInsetBrush}" BorderBrush="{ThemeResource AppDividerBrush}" BorderThickness="0,1,0,1" Padding="10,6">
                        <Grid ColumnDefinitions="1.05*,1.2*,1.9*,1.05*,Auto,Auto" ColumnSpacing="10">
                            <TextBlock Text="公司" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppMutedTextBrush}" />
                            <TextBlock Grid.Column="1" Text="岗位" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppMutedTextBrush}" />
                            <TextBlock Grid.Column="2" Text="JD" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppMutedTextBrush}" />
                            <TextBlock Grid.Column="3" Text="所用简历" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppMutedTextBrush}" />
                            <TextBlock Grid.Column="4" Text="状态" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppMutedTextBrush}" />
                            <TextBlock Grid.Column="5" Text="操作" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppMutedTextBrush}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <ListView x:Name="ApplicationsList" ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication, Mode=TwoWay}" SelectionChanged="OnBoardSelectionChanged" ItemTemplate="{StaticResource ApplicationRowTemplate}" SelectionMode="Single" BorderThickness="0" Background="Transparent" />
                        <StackPanel x:Name="ApplicationsLoadingState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <Border Width="240" Height="12" Background="{ThemeResource AppSurfaceRaisedBrush}" CornerRadius="6" />
                            <Border Width="190" Height="12" Background="{ThemeResource AppSurfaceRaisedBrush}" CornerRadius="6" />
                            <Border Width="220" Height="12" Background="{ThemeResource AppSurfaceRaisedBrush}" CornerRadius="6" />
                        </StackPanel>
                        <StackPanel x:Name="ApplicationsEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <Image Source="ms-appx:///Assets/empty-applications.svg" Width="120" Height="96" HorizontalAlignment="Center" />
                            <TextBlock Text="还没有投递记录" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Spacing="8">
                        <TextBlock Text="{Binding EmptyApplicationsMessage}" TextWrapping="Wrap" Foreground="{ThemeResource AppMutedTextBrush}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <ComboBox x:Name="StageComboBox" Header="投递状态" ItemsSource="{Binding ApplicationStages}" SelectedItem="{Binding SelectedApplicationStage, Mode=TwoWay}" IsEnabled="{Binding HasSelectedApplication}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Button Content="更新状态" Click="OnUpdateStageClick" IsEnabled="{Binding CanUpdateStage}" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="打开岗位" Click="OnOpenApplicationClick" IsEnabled="{Binding HasSelectedApplication}" Style="{StaticResource QuietButtonStyle}" />
                                <Button Content="撤销" Click="OnWithdrawClick" IsEnabled="{Binding CanWithdraw}" Style="{StaticResource QuietButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="TasksPanel" Grid.Column="1" Style="{StaticResource SectionBorderStyle}" Padding="14">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="复核看板" Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ReviewTasks.Count}" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid ColumnDefinitions="190,190,190" ColumnSpacing="10" MinWidth="590">
                            <Border Background="{ThemeResource AppSurfaceInsetBrush}" BorderBrush="{ThemeResource AppDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <Grid RowDefinitions="Auto,*">
                                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="待复核" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding QueuedReviewTasks.Count}" Foreground="{ThemeResource AppMutedTextBrush}" /></Grid>
                                    <ListView Grid.Row="1" ItemsSource="{Binding QueuedReviewTasks}" ItemTemplate="{StaticResource ReviewTaskCardTemplate}" SelectionChanged="OnTaskLaneSelectionChanged" SelectionMode="Single" BorderThickness="0" Background="Transparent" Margin="0,10,0,0" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource AppSurfaceInsetBrush}" BorderBrush="{ThemeResource AppDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <Grid RowDefinitions="Auto,*">
                                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="复核中" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding InReviewTasks.Count}" Foreground="{ThemeResource AppMutedTextBrush}" /></Grid>
                                    <ListView Grid.Row="1" ItemsSource="{Binding InReviewTasks}" ItemTemplate="{StaticResource ReviewTaskCardTemplate}" SelectionChanged="OnTaskLaneSelectionChanged" SelectionMode="Single" BorderThickness="0" Background="Transparent" Margin="0,10,0,0" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Background="{ThemeResource AppSurfaceInsetBrush}" BorderBrush="{ThemeResource AppDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <Grid RowDefinitions="Auto,*">
                                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="已完成" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding CompletedReviewTasks.Count}" Foreground="{ThemeResource AppMutedTextBrush}" /></Grid>
                                    <ListView Grid.Row="1" ItemsSource="{Binding CompletedReviewTasks}" ItemTemplate="{StaticResource ReviewTaskCardTemplate}" SelectionChanged="OnTaskLaneSelectionChanged" SelectionMode="Single" BorderThickness="0" Background="Transparent" Margin="0,10,0,0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <TextBlock Text="{Binding EmptyTasksMessage}" TextWrapping="Wrap" Foreground="{ThemeResource AppMutedTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="开始复核" Click="OnBeginReviewClick" IsEnabled="{Binding CanStartReview}" Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="完成" Click="OnCompleteReviewClick" IsEnabled="{Binding CanCompleteReview}" Style="{StaticResource QuietButtonStyle}" />
                            <Button Content="取消" Click="OnCancelTaskClick" IsEnabled="{Binding CanCancelTask}" Style="{StaticResource QuietButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
