<Page
    x:Class="BossFind.App.Views.OnlineResumePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <Page.Resources>
        <Style x:Key="ResumeSectionStyle" TargetType="Border" BasedOn="{StaticResource SectionBorderStyle}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="ResumeItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AppSurfaceInsetBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}" Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="3">
                <TextBlock Text="在线简历" Style="{StaticResource TitleTextBlockStyle}" FontSize="22" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing Width="20" Height="20" IsActive="{Binding IsLoading}" />
                <TextBlock Text="{Binding Status}" Foreground="{ThemeResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SectionBorderStyle}" Padding="16">
            <Grid ColumnDefinitions="260,*,Auto" ColumnSpacing="14">
                <ComboBox Header="选择简历" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="请选择简历" />
                <TextBox Grid.Column="1" Header="原文（可选）" Text="{Binding SourceText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="72" PlaceholderText="粘贴原文" />
                <Button Grid.Column="2" Content="提取" Click="OnExtractClick" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsRepeater ItemsSource="{Binding Sections}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="380" MinItemHeight="120" MaximumRowsOrColumns="2" Orientation="Horizontal" MinColumnSpacing="10" MinRowSpacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ResumeSectionStyle}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="15" />
                                        <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <ItemsRepeater ItemsSource="{Binding Items}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ResumeItemStyle}">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                            <Button Grid.Column="1" Tag="{Binding}" Click="OnCopyItemClick" Style="{StaticResource ToolButtonStyle}" Width="30" Height="30" MinHeight="30" ToolTipService.ToolTip="复制此项" Padding="0">
                                                                <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                                            </Button>
                                                        </Grid>
                                                        <TextBox Text="{Binding Content}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="36" MaxHeight="58" Background="{ThemeResource AppSurfaceBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,18,0,30" Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="暂无内容" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
