<Page
    x:Class="BossFind.App.Views.BossBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <Grid ColumnDefinitions="*,360" RowDefinitions="*,Auto">
        <WebView2 x:Name="BossWebView" Grid.RowSpan="2" />
        <ScrollViewer Grid.Column="1" Padding="20" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
            <TextBlock Text="Boss 浏览器" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            <TextBlock Text="独立 Profile" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ProfilePath}" TextWrapping="Wrap" />
            <TextBlock Text="岗位摘要" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{Binding JobTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Company}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding City}" Opacity="0.72" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Tags}" Opacity="0.72" TextWrapping="Wrap" />
            <TextBox Header="候选人姓名" Text="{Binding CandidateName, Mode=TwoWay}" />
            <Button Content="导入候选人档案" Click="OnImportClick" IsEnabled="{Binding IsSummaryReady}" />
            <ProgressRing Width="24" Height="24" IsActive="{Binding IsBusy}" />
            <TextBlock Text="当前页面仅加载固定测试页，不会访问或操作招聘平台。" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="1" Grid.Row="1" Padding="20" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock Text="自动化状态：未启用" />
        </Border>
    </Grid>
</Page>
